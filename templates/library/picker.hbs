<div class="tom-lib-window">
  <nav class="tom-lib-tabs" role="tablist">
    {{#each tabs}}
      <button type="button" class="tom-lib-tab {{#if active}}is-active{{/if}}" data-library-tab="{{id}}" role="tab" aria-selected="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
    {{/each}}
  </nav>

  <div class="tom-lib-layout">
    <aside class="tom-lib-folders">
      <div class="tom-lib-folder-actions">
        <button type="button" data-tom="create-item">
          <i class="fas fa-image"></i>
          {{labels.createItem}}
        </button>
        <button type="button" data-tom="create-folder">
          <i class="fas fa-folder-plus"></i>
          {{labels.createFolder}}
        </button>
        <button type="button" data-tom="create-bulk">
          <i class="fas fa-layer-group"></i>
          {{labels.createBulk}}
        </button>
      </div>
      <div class="tom-lib-folder-tree" data-folder-tree></div>
    </aside>

    <section class="tom-lib-gallery-pane">
      <div class="tom-lib-gallery-toolbar">
        <div class="tom-lib-search">
          <input type="text" data-search value="{{search}}" placeholder="{{labels.search}}">
          <button type="button" data-tom="clear-search" title="{{labels.clearSearch}}">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="tom-lib-size">
          <button type="button" data-size="small" title="{{labels.sizeSmall}}"><i class="fas fa-th"></i></button>
          <button type="button" data-size="medium" title="{{labels.sizeMedium}}"><i class="fas fa-th-large"></i></button>
          <button type="button" data-size="large" title="{{labels.sizeLarge}}"><i class="fas fa-image"></i></button>
        </div>
      </div>
      <div class="tom-lib-gallery is-medium" data-gallery></div>
    </section>
  </div>
</div>
