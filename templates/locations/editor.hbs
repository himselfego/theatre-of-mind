<div class="tom-loc-editor">
  <div class="tom-loc-editor-preview" data-preview>
    <img alt="" hidden>
    <p class="notes" data-preview-empty>{{localize "GINZZZUPORTRAITS.Locations.previewEmpty"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "GINZZZUPORTRAITS.Locations.image"}}</label>
    <div class="tom-loc-file">
      <input type="text" data-field="image" value="{{image}}">
      <button type="button" data-tom="pick-image" title="{{localize "GINZZZUPORTRAITS.Locations.image"}}">
        <i class="fas fa-file-image"></i>
      </button>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "GINZZZUPORTRAITS.Locations.name"}}</label>
    <input type="text" data-field="name" value="{{name}}">
  </div>

  <div class="form-group">
    <label>{{localize "GINZZZUPORTRAITS.Locations.folder"}}</label>
    <select data-field="folder">
      {{#each folders}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>

  <label class="tom-loc-check">
    <input type="checkbox" data-field="outdoors" {{#if outdoors}}checked{{/if}}>
    <span>{{localize "GINZZZUPORTRAITS.Locations.outdoors"}}</span>
  </label>

  <button type="button" data-tom="save">
    <i class="fas fa-check"></i>
    {{localize "GINZZZUPORTRAITS.Locations.save"}}
  </button>
</div>
